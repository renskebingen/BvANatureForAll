<!DOCTYPE html>
<html lang="nl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Farm Map</title>

  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet/dist/leaflet.css"
  />

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

  <!-- Heatmap -->
  <script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="map">

  <!-- =========================
       FILTER OVERLAY
  ========================== -->
  <div id="uiTopLeft" class="mapFilters">

    <label class="filterItem">
      <input type="checkbox" id="layerBoerderij" checked>
      <span>🚜 Boeren</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerVerkooppunten" checked>
      <span>🛒 Verkooppunten</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerPolder" checked>
      <span>🏡 Polders</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerAmstelland" checked>
      <span>🌾 Amstelland</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerHeatmap" checked>
      <span>🌱 Biodiversiteit</span>
    </label>

     <label class="filterItem">
      <input type="checkbox" id="layerData">
      <span>📈 Data</span>
    </label>

  </div>

   <!-- =========================
       Algemene data Widget
  ========================== -->
  <div class="algemeneData">
    <div class="dataWidget">
      <p>€81.234.00</p>
      <p>In het weidevogel fonds</p>
    </div>

    <div class="dataWidget">
      <p>51.245 m2</p>
      <p>Biodiversiteit ingezaaid</p>
    </div>
  </div>

  <!-- =========================
       Links andere pagina
  ========================== -->
  <div class="paginaLink">
    <a href="/oevertjekopen">Oevertje Kopen</a>
    <a href="#">Boerderij evenementen</a>
  </div>

  <!-- =========================
       OVERLAY PANEL
  ========================== -->
  <div class="stylingborderpanel">
  <div id="panel" class="panel">

    <button id="closePanel" class="panelClose" aria-label="Sluit panel">
      ✕
    </button>

    <header class="panelHeader">
      <h2 id="farmTitle">
        Klik op een boerderij
      </h2>
    </header>

    <div class="panelContent">
      <section class="panelSection">
        <h3>Over onze boer</h3>
        <p id="farmDesc">
          Selecteer een marker.
        </p>
        <a id="farmStoryLink" class="panelTextLink" href="#" hidden>
          Lees het hele verhaal hier
        </a>
      </section>

      <section class="panelSection">
        <h3>Praktische Informatie</h3>
        <div class="panelInfoList">
          <p id="farmLoc" class="panelInfoItem panelInfoItemLocation">
            Geen adres gevonden
          </p>
          <p id="farmLink" class="panelInfoItem panelInfoItemLink" hidden></p>
        </div>
      </section>

      <section id="farmMediaSection" class="panelSection">
        <h3>Media</h3>
        <div id="farmMedia" class="panelMediaGrid"></div>
      </section>
    </div>

