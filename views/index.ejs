<!DOCTYPE html>
<html lang="nl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Farm Map</title>

  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet/dist/leaflet.css"
  />

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

  <!-- Heatmap -->
  <script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="map">

  <!-- =========================
       FILTER OVERLAY
  ========================== -->
  <div id="uiTopLeft" class="mapFilters">

    <label class="filterItem">
      <input type="checkbox" id="layerBoerderij" checked>
      <span>🚜 Boeren</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerPolder" checked>
      <span>🏡 Polders</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerAmstelland" checked>
      <span>🌾 Amstelland</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerHeatmap" checked>
      <span>🌱 Biodiversiteit</span>
    </label>

  </div>


  <!-- =========================
       OVERLAY PANEL
  ========================== -->
  <div id="panel" class="panel">

    <button id="closePanel">
      ✕
    </button>

    <h2 id="farmTitle">
      Klik op een boerderij
    </h2>

    <p id="farmDesc">
      Selecteer een marker.
    </p>

  </div>


  <!-- =========================
       MAP
  ========================== -->
  <div id="map"></div>


  <!-- =========================
       DATA
  ========================== -->
  <script>
    window.FARMS = <%- JSON.stringify(farms) %>;
  </script>


  <!-- =========================
       APP
  ========================== -->
  <script src="/js/app.js"></script>

</body>

</html>