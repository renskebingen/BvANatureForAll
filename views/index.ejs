<!DOCTYPE html>
<html lang="nl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Farm Map</title>

  <!-- Leaflet -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet/dist/leaflet.css"
  />

  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

  <!-- Heatmap -->
  <script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="map">

  <!-- =========================
       FILTER OVERLAY
  ========================== -->
  <div id="uiTopLeft" class="mapFilters">

    <label class="filterItem">
      <input type="checkbox" id="layerBoerderij" checked>
      <span>🚜 Boeren</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerVerkooppunten" checked>
      <span>🛒 Verkooppunten</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerPolder" checked>
      <span>🏡 Polders</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerAmstelland" checked>
      <span>🌾 Amstelland</span>
    </label>

    <label class="filterItem">
      <input type="checkbox" id="layerHeatmap" checked>
      <span>🌱 Biodiversiteit</span>
    </label>

     <label class="filterItem">
      <input type="checkbox" id="layerData">
      <span>📈 Data</span>
    </label>

  </div>

   <!-- =========================
       Algemene data Widget
  ========================== -->
  <div class="algemeneData">
    <div class="dataWidget">
      <p>€81.234.00</p>
      <p>In het weidevogel fonds</p>
    </div>

    <div class="dataWidget">
      <p>51.245 m2</p>
      <p>Biodiversiteit ingezaaid</p>
    </div>
  </div>

  <!-- =========================
       Links andere pagina
  ========================== -->
  <div class="paginaLink">
    <a href="/oevertjekopen">Oevertje Kopen</a>
    <a href="#">Boerderij evenementen</a>
  </div>

  <!-- =========================
       OVERLAY PANEL
  ========================== -->
  <div id="panel" class="panel">

    <button id="closePanel">
      ✕
    </button>

    <h2 id="farmTitle">
      Klik op een boerderij
    </h2>

    <p id="farmDesc">
      Selecteer een marker.
    </p>

  </div>

 <!-- =========================
       DATA PANEL
  ========================== -->
  <div class="dataDashboard">

    <!-- Rechtercards -->
    <div class="rechterCards">
      <!-- SDG card -->
      <div class="card sdg-card">
        <h2>SDG impact</h2>

        <div class="progressRow">

          <div class="circle">
            <div class="circleInner">92%</div>
          </div>

          <div class="circle">
            <div class="circleInner">95%</div>
          </div>

          <div class="circle">
            <div class="circleInner">78%</div>
          </div>

        </div>
      </div>

      <!-- NATUURHERSTEL -->
      <div class="card natuur-card">
        <h2>Natuurherstel</h2>

        <p>Biodiversiteit index: <strong>7.8</strong></p>

        <p>Weidevogel nesten: <strong>142</strong></p>

        <p>Plas-dras oppervlakte: <strong>12.5 ha</strong></p>
      </div>

      <!-- TRUE VALUE -->
      <div class="card table-card">
        <h2>True Value Impact</h2>

        <table>
          <tr>
            <th>Categorie</th>
            <th>Onderwerp</th>
            <th>Impact</th>
          </tr>

          <tr>
            <td>Ecologie</td>
            <td>Waterkwaliteit</td>
            <td>...</td>
          </tr>

          <tr>
            <td>Ecologie</td>
            <td>Foodmiles</td>
            <td>...</td>
          </tr>

        </table>
      </div>

      <div class="card rapport">
        <a href="formulier.pdf" download>
          <button>Download formulier</button>
        </a>
      </div>

    </div>


    <!-- ONDERSTE CARDS -->
    <div class="bottomCards">

      <div class="card smallCard">
        <h3>Sustainable Development Goals</h3>

        <p>SDG 3 - Goede gezondheid</p>
        <p>SDG 12 - Verantwoorde productie</p>
        <p>SDG 16 - Vrede en recht</p>
      </div>

      <div class="card smallCard">
        <h3>Biodiversiteit</h3>

        <p>Inzaaiingen: 51.245 m2</p>
        <p>Oeverherstel: 2.4 km</p>
      </div>

      <div class="card smallCard">
        <h3>Weidevogelfonds</h3>

        <p>€ 81.234</p>
      </div>

    </div>

  </div>

  <!-- =========================
       MAP
  ========================== -->
  <div id="map"></div>


  <!-- =========================
       DATA
  ========================== -->
  <script id="farms-data" type="application/json"><%- JSON.stringify(farms || []) %></script>
  <script id="verkooppunten-data" type="application/json"><%- JSON.stringify(verkooppunten || []) %></script>


  <!-- =========================
       APP
  ========================== -->
  <script src="/js/app.js"></script>

</body>

</html>
