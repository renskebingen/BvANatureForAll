<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oevertje kopen</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
    <body class="oeverpagina">
        <header>
            <nav class="navbar">
                <a href="/" class="logo">
                    <img src="/images/logobva.png" alt="LogoBVA">
                </a>

                <ul class="nav-links">
                    <li><a href="/oevertjekopen" class="active">Doe mee</a></li>
                    <li><a href="/oevertjekopen">Bedrijven</a></li>
                    <li><button class="kopenoevernav">Koop hier je oevertje!</button></li>
                    
                    <span class="nav-indicator"></span>
                </ul>
            </nav>

            <div class="banner-container">
                <img src="/images/banner.png" alt="Banner oever" class="header-image">

                <h1 class="h1oevertje">Koop een oevertje</h1>
                <p class="banner-text">De boeren van Amstel zetten zich iedere dag in voor een gezond en biodivers landschap. Jouw donatie helpt hen om die verandering zichtbaar te maken.</p>
                <button class="kopenoeverbanner">Koop je oevertje!</button>
            </div>
        </header>
    
        <section class="oevertjekopen">

            <div class="maakhetverschil">
                <h2 class="oeverh2">Maak het verschil</h2>
                <p>Voor bedrijven klik <a href="/bedrijven">hier</a></p>
            </div>

            <div class="donatie-tabs">

                <p>Jaarlijks</p>
                <p class="active">Maandelijks</p>
                <p>Eenmalig</p>

                <span class="tab-indicator"></span>

            </div>

            <div class="oevertje-cards">

            <article class="">

                <img src="/images/oevertje.jpg" alt="Oevertje" class="oevertje-image">

                <h3>Titel</h3>

                <ul>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                </ul>

                <button class="kopen-btn">Kopen</button>

            </article>


            <article>

                <img src="/images/oevertje.jpg" alt="Oevertje" class="oevertje-image">

                <h3>Titel</h3>

                <ul>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                </ul>

                <button class="kopen-btn">Kopen</button>

            </article>


            <article>

                <img src="/images/oevertje.jpg" alt="Oevertje" class="oevertje-image">

                <h3>Titel</h3>

                <ul>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                    <li>voorwaarden</li>
                </ul>

                <button class="kopen-btn">Kopen</button>

            </article>

            </div>

        </section>

        <section class="timeline">

            <section class="timeline-group">

                <article class="timeline-event">

                    <img src="/images/oevertje.jpg" alt="Oevertje">

                    <h2>Starter Oevertje</h2>

                    <p>
                        Je koopt je eerste oevertje.
                    </p>

                </article>

                <div class="timeline-point">
                    <span></span>
                </div>

                <div class="timeline-date">
                    <p>Stap 1</p>
                </div>

            </section>

            <section class="timeline-group">

                <article class="timeline-event">

                    <img src="/images/oevertje.jpg" alt="Oevertje">

                    <h2>Activatie</h2>

                    <p>
                        Het oevertje wordt verwerkt en toegevoegd.
                    </p>

                </article>

                <div class="timeline-point">
                    <span></span>
                </div>

                <div class="timeline-date">
                    <p>Stap 2</p>
                </div>

            </section>

            <section class="timeline-group">

                <article class="timeline-event">

                    <img src="/images/oevertje.jpg" alt="Oevertje">

                    <h2>Resultaat</h2>

                    <p>
                        Je bijdrage heeft impact op de natuur.
                    </p>

                </article>

                <div class="timeline-point">
                    <span></span>
                </div>

                <div class="timeline-date">
                    <p>Stap 3</p>
                </div>

            </section>

        </section>

        <!-- =========================
        APP
        ========================== -->
        <script src="/js/tijdlijn.js"></script>

    </body>
</html>