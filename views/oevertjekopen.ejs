                            <p>PER MAAND:</p>
                            <span>€10,-</span>
                        </div>

                        <button class="kopen-btn">
                            Oevertje kopen
                        </button>

                    </div>

                    <img src="/images/footer.png"
                        alt="footer"
                        class="card-footer">

                </article>

                <article>

                    <div class="card-top">

                        <h3>.... Meter</h3>

                        <img src="/images/laagstebedrag.png"
                            alt="Oevertje"
                            class="oevertje-image">

